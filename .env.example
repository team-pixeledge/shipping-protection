# Shopify (from the Dev Dashboard / `shopify app env show`)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
# Keep in step with shopify.app.toml [access_scopes], or auth loops.
SCOPES=write_products,read_publications,write_publications,read_orders,write_orders,read_themes,write_validations

# Postgres. Vercel: Neon via the Marketplace sets both (pooled + direct).
# AWS later: RDS, same URL for both. Local: docker on 55451.
DATABASE_URL=postgresql://postgres:postgres@localhost:55451/shipping_protection
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:55451/shipping_protection
