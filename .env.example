# Shopify (from the Dev Dashboard / `shopify app env show`)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
# Keep in step with shopify.app.toml [access_scopes], or auth loops.
SCOPES=write_products,read_publications,write_publications,read_orders,write_orders,read_themes,write_validations

# Claims (optional — without them claims still work, minus emails/uploads).
# Resend: verify a sending domain, then set the key and a From address on it.
RESEND_API_KEY=
CLAIMS_EMAIL_FROM=claims@example.com
# Vercel Blob: create a PRIVATE store and connect it to the project; Vercel
# sets this. Evidence uploads are hidden on the claims page until it's set.
BLOB_READ_WRITE_TOKEN=

# Daily job (tracking sync, cleanup). Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# true = every charge is a test charge (staging). Dev stores get test charges anyway.
BILLING_TEST=

# Postgres. Vercel: Neon via the Marketplace sets both (pooled + direct).
# AWS later: RDS, same URL for both. Local: docker on 55451.
DATABASE_URL=postgresql://postgres:postgres@localhost:55451/shipping_protection
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:55451/shipping_protection
