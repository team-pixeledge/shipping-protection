generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon (Vercel Marketplace integration sets both): DATABASE_URL = pooled
  // host for the serverless runtime, DATABASE_URL_UNPOOLED = direct host for
  // `prisma migrate`. On AWS later: point both at RDS.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Managed by @shopify/shopify-app-session-storage-prisma — keep its shape.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  shop          String    @id // myshop.myshopify.com
  currency      String    @default("USD") // shop currency, ISO 4217
  installedAt   DateTime  @default(now())
  // Set on app/uninstalled; cleared on reinstall. shop/redact deletes the row.
  uninstalledAt DateTime?

  // The merchant's settings (app/lib/settings.ts → Settings). null = never
  // saved: protection stays off until the first save, so installing the
  // app changes nothing on the storefront.
  settings      Json?
  // Bumped on every save. syncedVersion = last version pushed to Shopify
  // (product variants, metafields, validation); they differ only while a
  // sync failed — syncError says why.
  version       Int       @default(0)
  syncedVersion Int       @default(0)
  syncError     String?

  // Created by the app on first save (setup.server.ts).
  productId     String? // gid://shopify/Product/…
  productHandle String?
  validationId  String? // gid://shopify/Validation/…
  // Exact pricing (Plus): the protection-transform cart transform, when on.
  cartTransformId String?

  // Storefront path of the app proxy ("/apps/safeship"; merchants can
  // rename the subpath). Learnt from each proxy request, used to build the
  // claim links sent by email.
  portalPath    String    @default("/apps/safeship")

  // Development or sandbox store: charges are test charges (no money moves).
  // Set on every auth from shop.plan.partnerDevelopment (or BILLING_TEST=true).
  billingTest   Boolean   @default(false)
  // The active plan (app/lib/plan.ts PlanId), null = none approved. Synced
  // from Shopify on every admin load and by app_subscriptions/update, so
  // webhooks and the daily job can gate features without an API call.
  plan          String?

  updatedAt DateTime @updatedAt

  orders    OrderRecord[]
  claims    Claim[]
  shipments Shipment[]
  usage     UsageCharge[]
}

// One row per order seen by orders/create — protected or not — for the
// dashboard's attach rate and revenue. No customer data: amounts, order
// name and the shopper's choice only. Upserted, so webhook retries are
// harmless.
model OrderRecord {
  shop        String
  orderId     String // numeric Shopify order ID
  orderName   String // "#1001"
  protected   Boolean
  // "accepted" | "declined" | null (never chose: default applied or not offered)
  choice      String?
  // Protection charged, shop currency (0 when not protected).
  fee         Decimal  @db.Decimal(12, 2)
  currency    String
  orderedAt   DateTime
  // Last time the daily sync looked for this order's packages (protected
  // orders whose fulfillment webhooks we may have missed).
  trackedAt   DateTime?
  createdAt   DateTime @default(now())

  shopRef Shop @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@id([shop, orderId])
  @@index([shop, orderedAt])
}

// A customer's claim on an order (lost, stolen or damaged package). Filed on
// the storefront claims page (app proxy, app/routes/proxy.*), reviewed in
// the admin (app/routes/app.claims*). Holds customer data — the email the
// customer gave and their description — so customers/redact deletes it
// (webhooks.compliance.tsx), along with the evidence files in Blob storage.
model Claim {
  id          String   @id @default(cuid())
  shop        String
  // Per-shop sequence shown as "C-1001".
  number      Int
  orderId     String // numeric Shopify order ID
  orderName   String
  // LOST | STOLEN | DAMAGED
  type        String
  // OPEN | NEEDS_INFO | APPROVED | REJECTED (app/lib/claims.ts)
  status      String   @default("OPEN")
  email       String
  description String
  // The order lines claimed: [{ lineItemId, title, quantity, amount }]
  // (amount = shop currency, for the quantity claimed).
  items       Json
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  // Whether protection was bought on the order, when the claim was filed.
  protected   Boolean
  // Review hints, never verdicts: e.g. NO_PROTECTION, MARKED_DELIVERED.
  flags       String[]
  // Shipping snapshot at filing time: [{ status, tracking: [{ number, company, url }], shippedAt, deliveredAt }]
  shipments   Json
  // Flags the merchant marked as false positives (still listed, struck through).
  dismissedFlags String[] @default([])
  // Normalised tracking numbers of the claimed packages — duplicate checks.
  trackingNumbers String[] @default([])
  // HMAC of the normalised shipping address (never the address itself) —
  // repeat-address checks. null when the address couldn't be read.
  addressHash String?
  // The customer's language (the order's customer locale): claims page and emails.
  locale      String   @default("en")
  // CUSTOMER (claims page) | STAFF (created in the admin).
  source      String   @default("CUSTOMER")
  // Recorded on approval: REFUND | REPLACEMENT | STORE_CREDIT | OTHER.
  // Phase 1 only records the decision; the merchant carries it out in Shopify.
  resolution  String?
  decidedAt   DateTime?
  // Set when the resolution was carried out (a ClaimResolution is DONE).
  // A resolved claim can't be reopened: money or goods have moved.
  resolvedAt  DateTime?
  // The ClaimResolution being carried out right now. Taken with a
  // conditional update, so two clicks or two staff can't both refund.
  resolutionLock String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shopRef Shop         @relation(fields: [shop], references: [shop], onDelete: Cascade)
  events      ClaimEvent[]
  files       ClaimFile[]
  resolutions ClaimResolution[]

  @@unique([shop, number])
  @@index([shop, status, createdAt])
  @@index([shop, orderId])
  @@index([shop, email])
  @@index([shop, addressHash])
}

// The claim's history: every status change, message, note and email.
// Append-only. internal = merchant-only note, never shown to the customer.
model ClaimEvent {
  id        String   @id @default(cuid())
  claimId   String
  // CUSTOMER | MERCHANT | SYSTEM
  actor     String
  // SUBMITTED | STATUS | MESSAGE | NOTE | FILES | EMAIL
  kind      String
  status    String? // the new status, for STATUS
  message   String?
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
}

// Evidence a customer uploaded. The bytes live in a private Vercel Blob
// store under claims/<shop>/<orderId>/…; the admin shows them through
// short-lived signed links (app/routes/claim-files.$id.tsx).
model ClaimFile {
  id          String   @id @default(cuid())
  claimId     String
  pathname    String   @unique
  name        String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

// Carrying out an approved claim (app/lib/resolutions.server.ts): a refund,
// a replacement order, store credit, or a cost recorded by hand. amount is
// what it cost the merchant, in the shop currency — the number the
// program results (fees collected − claim costs) are built from.
model ClaimResolution {
  id          String    @id @default(cuid())
  claimId     String
  // REFUND | REPLACEMENT | STORE_CREDIT | MANUAL
  type        String
  // PROCESSING | DONE | FAILED
  status      String    @default("PROCESSING")
  amount      Decimal   @db.Decimal(12, 2)
  currency    String
  // What Shopify created: Refund, DraftOrder→Order, or store-credit
  // transaction gid; shopifyName is the replacement order's name.
  shopifyId   String?
  shopifyName String?
  note        String?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([status, completedAt])
}

// One package (a Shopify fulfillment) of a protected or claimed order, kept
// up to date by the fulfillment webhooks and the daily sync
// (app/lib/tracking.server.ts). No customer data: carrier facts only.
model Shipment {
  shop          String
  fulfillmentId String // numeric
  orderId       String
  orderName     String
  // Shopify's displayStatus (IN_TRANSIT, DELIVERED, …) and our stage (app/lib/tracking.ts).
  status        String
  stage         String
  tracking      Json // [{ number, company, url }]
  trackingNumbers String[] @default([]) // normalised, for duplicate checks
  lineItemIds   String[] @default([])
  shippedAt     DateTime
  inTransitAt   DateTime?
  deliveredAt   DateTime?
  estimatedDeliveryAt DateTime?
  // The carrier's latest event (null: the carrier reports none).
  lastEventAt   DateTime?
  lastEventStatus String?
  flags         String[] @default([])
  // When the flags last changed (newest problems first in the admin).
  flaggedAt     DateTime?
  checkedAt     DateTime @default(now())
  // Delivered, cancelled or followed long enough: the daily sync skips it.
  closedAt      DateTime?
  updatedAt     DateTime @updatedAt

  shopRef Shop @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@id([shop, fulfillmentId])
  @@index([shop, orderId])
  @@index([shop, closedAt, shippedAt])
  @@index([closedAt, checkedAt])
}

// Fixed-window counters for the storefront order lookup (and anything else
// a stranger can hammer). Expired rows are deleted by the daily job.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// Billing: one row per protected order, recording whether it fell in the
// billing cycle's free allowance or was charged as a Shopify usage record
// (app/lib/billing.server.ts). The unique key makes webhook retries safe.
model UsageCharge {
  shop        String
  orderId     String
  orderName   String
  // FREE (within the cycle's free orders) | CHARGED | CAPPED (the monthly
  // cap was reached) | NO_PLAN (no active subscription) | FAILED
  status      String
  amount      Decimal  @db.Decimal(10, 2) // USD charged (0 unless CHARGED)
  // The subscription cycle's end, which groups rows into cycles.
  periodEnd   DateTime?
  usageRecordId String?
  error       String?
  test        Boolean  @default(false)
  createdAt   DateTime @default(now())

  shopRef Shop @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@id([shop, orderId])
  @@index([shop, periodEnd])
}
